# ---------------------------------------------------------------------------
# Einstellungen fuer das Kassasystem.
#
# So verwenden:
#     cp .env.example .env
#     nano .env
#
# Die Datei .env enthaelt das Passwort und gehoert NICHT ins Git-Repository
# (dafuer sorgt die .gitignore in diesem Ordner).
# Nach jeder Aenderung:  docker compose up -d
# ---------------------------------------------------------------------------


# Die Domain, unter der der Server erreichbar ist.
# Muss per DNS-A-Record auf die IP-Adresse des VPS zeigen, BEVOR der
# Server das erste Mal gestartet wird — sonst bekommt Caddy kein
# Zertifikat. Ohne "https://" und ohne Schraegstrich am Ende.
DOMAIN=kassa.beispiel.at

# E-Mail-Adresse fuer Let's Encrypt. Dorthin kommt eine Warnung, falls das
# Zertifikat einmal nicht erneuert werden kann. Eine Adresse, die auch
# wirklich gelesen wird.
ACME_EMAIL=betreiber@beispiel.at


# Passwort, mit dem sich die iPhones am Server anmelden.
#
# Ein starkes Passwort erzeugen (auf dem VPS eingeben):
#     openssl rand -base64 24
#
# Die Ausgabe hier einsetzen. Das Passwort wird pro Gerat nur EINMAL
# eingetippt und danach gespeichert — es darf also ruhig unhandlich sein.
#
# Zwei Dinge beachten:
#   - Keine Anfuehrungszeichen drumherum setzen.
#   - Keine Rautezeichen (#) und keine Dollarzeichen ($) verwenden, die
#     werden hier als Sonderzeichen gelesen. Die Ausgabe von
#     "openssl rand -base64 24" enthaelt beides nie.
KASSA_PASSWORD=hier-ein-eigenes-passwort-einsetzen


# Anzahl der Tische im Lokal.
TABLE_COUNT=40

# Ab welcher Uhrzeit ein neuer Betriebstag beginnt (0-23).
# 6 bedeutet: Was um 02:00 Uhr nachts bestellt wird, zaehlt noch zum
# Vortag. So zerschneidet der Tagesabschluss nicht den laufenden Betrieb.
BUSINESS_DAY_CUTOFF_HOUR=6


# Hinweis: PORT und DATABASE_PATH stehen bewusst nicht hier, sondern fest
# in docker-compose.yml. Sie haengen am Docker-Volume bzw. am Proxy und
# lassen sich nicht unabhaengig aendern.
